# Arkestra identity for the VSCodium build scripts (vendor/vscodium/utils.sh).
export APP_NAME="Arkestra"
export BINARY_NAME="arkestra"
export ORG_NAME="tenarkhq"
export GH_REPO_PATH="tenarkhq/Arkestra"
export ASSETS_REPOSITORY="tenarkhq/Arkestra"
export VSCODE_QUALITY="${VSCODE_QUALITY:-stable}"
# Auto-update comes later (AR33); until then the update service is off.
export DISABLE_UPDATE="yes"
