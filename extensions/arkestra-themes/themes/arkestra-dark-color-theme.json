	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#7D889C",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#C9A6FF"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#7FB7FF"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#9FE09A"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#FFB067"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#6FD3E8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#FF7A59"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#FFB067"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#E4E9F2"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#B5BFD0"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#FF7A59",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#5FE0B7"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#FF7A7A"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#FFB067"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#FF7A7A"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#7FB7FF",
		"method": "#7FB7FF",
		"type": "#6FD3E8",
		"class": "#6FD3E8",
		"keyword": "#C9A6FF",
		"string": "#9FE09A",
		"number": "#FFB067",
		"parameter": "#E4E9F2",
		"property": "#E4E9F2"
	}
}