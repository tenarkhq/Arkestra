	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#667085",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#7A3FD1"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#1F5FBF"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#2F7D32"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"support.constant",
				"variable.language"
			],
			"settings": {
				"foreground": "#C0650E"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#0B7A8C"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag"
			],
			"settings": {
				"foreground": "#D24B2A"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#C0650E"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#141A26"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#3B4558"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#D24B2A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#0F8A66"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#C23B3B"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#C0650E"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#C23B3B"
			}
		}
	],
	"semanticTokenColors": {
		"function": "#1F5FBF",
		"method": "#1F5FBF",
		"type": "#0B7A8C",
		"class": "#0B7A8C",
		"keyword": "#7A3FD1",
		"string": "#2F7D32",
		"number": "#C0650E",
		"parameter": "#141A26",
		"property": "#141A26"
	}
}