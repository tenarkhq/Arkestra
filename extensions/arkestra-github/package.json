{
  "name": "arkestra-github",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:arkestra.project",
    "onWebviewPanel:arkestra.boards"
  ],
  "main": "./out/extension",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Arkestra · GitHub",
      "properties": {
        "arkestra.github.relayUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%relayUrl%"
        },
        "arkestra.github.appSlug": {
          "type": "string",
          "default": "",
          "markdownDescription": "%appSlug%"
        },
        "arkestra.github.project": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%project%"
        },
        "arkestra.github.cardFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "%cardFields%"
        },
        "arkestra.github.laneField": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%laneField%"
        },
        "arkestra.github.weightField": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%weightField%"
        }
      }
    },
    "commands": [
      {
        "command": "arkestra.github.openBoard",
        "title": "%openBoard%",
        "category": "Arkestra",
        "icon": "$(project)"
      },
      {
        "command": "arkestra.github.openBoards",
        "title": "%openBoards%",
        "category": "Arkestra",
        "icon": "$(project)"
      },
      {
        "command": "arkestra.github.connect",
        "title": "%connect%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.disconnect",
        "title": "%disconnect%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.install",
        "title": "%install%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.log",
        "title": "%log%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.signIn",
        "title": "%signIn%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.setProject",
        "title": "%setProject%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.github.refreshProject",
        "title": "%refreshProject%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.remote.start",
        "title": "%remote.start%",
        "category": "Arkestra",
        "icon": "$(radio-tower)"
      },
      {
        "command": "arkestra.remote.stop",
        "title": "%remote.stop%",
        "category": "Arkestra",
        "icon": "$(debug-stop)"
      },
      {
        "command": "arkestra.remote.pair",
        "title": "%remote.pair%",
        "category": "Arkestra",
        "icon": "$(key)"
      },
      {
        "command": "arkestra.remote.copyLink",
        "title": "%remote.copyLink%",
        "category": "Arkestra",
        "icon": "$(copy)"
      },
      {
        "command": "arkestra.remote.toggleAll",
        "title": "%remote.toggleAll%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.remote.menu",
        "title": "%remote.menu%",
        "category": "Arkestra"
      }
    ],
    "menus": {
      "commandPalette": []
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:arkestra-github",
    "watch": "gulp watch-extension:arkestra-github"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
