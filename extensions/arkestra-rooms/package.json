{
  "name": "arkestra-rooms",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onChatParticipant:arkestra.room",
    "onChatSession:arkestra-room",
    "onView:arkestra.threads",
    "onWebviewPanel:arkestra.agents",
    "onWebviewPanel:arkestra.lane"
  ],
  "main": "./out/extension",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "arkestra.room",
        "name": "room",
        "fullName": "%room.fullName%",
        "description": "%room.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "invite",
            "description": "%command.invite%"
          },
          {
            "name": "agents",
            "description": "%command.agents%"
          },
          {
            "name": "new",
            "description": "%command.new%"
          },
          {
            "name": "template",
            "description": "%command.template%"
          },
          {
            "name": "continue",
            "description": "%command.continue%"
          },
          {
            "name": "approve",
            "description": "%command.approve%"
          },
          {
            "name": "plan",
            "description": "%command.plan%"
          },
          {
            "name": "execute",
            "description": "%command.execute%"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "arkestra.rooms.new",
        "title": "%command.new%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.invite",
        "title": "%command.invite%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.open",
        "title": "%command.open%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.showAgents",
        "title": "%showAgents%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.newThread",
        "title": "%command.newThread%",
        "category": "Arkestra",
        "icon": "$(add)"
      },
      {
        "command": "arkestra.rooms.openThread",
        "title": "%command.openThread%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.pin",
        "title": "%command.pin%",
        "category": "Arkestra",
        "icon": "$(pin)"
      },
      {
        "command": "arkestra.rooms.unpin",
        "title": "%command.unpin%",
        "category": "Arkestra",
        "icon": "$(pinned)"
      },
      {
        "command": "arkestra.rooms.setCategory",
        "title": "%command.setCategory%",
        "category": "Arkestra",
        "icon": "$(tag)"
      },
      {
        "command": "arkestra.rooms.rename",
        "title": "%command.rename%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.showLane",
        "title": "%showLane%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.newTemplateRoom",
        "title": "%command.newTemplateRoom%",
        "category": "Arkestra",
        "icon": "$(rocket)"
      },
      {
        "command": "arkestra.changes.keep",
        "title": "%changes.keep%",
        "category": "Arkestra",
        "icon": "$(check)"
      },
      {
        "command": "arkestra.changes.discard",
        "title": "%changes.discard%",
        "category": "Arkestra",
        "icon": "$(discard)"
      },
      {
        "command": "arkestra.changes.keepAll",
        "title": "%changes.keepAll%",
        "category": "Arkestra",
        "icon": "$(check-all)"
      },
      {
        "command": "arkestra.changes.discardAll",
        "title": "%changes.discardAll%",
        "category": "Arkestra",
        "icon": "$(clear-all)"
      },
      {
        "command": "arkestra.changes.open",
        "title": "%changes.open%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.checkpoints.restore",
        "title": "%checkpoints.restore%",
        "category": "Arkestra",
        "icon": "$(history)"
      },
      {
        "command": "arkestra.checkpoints.show",
        "title": "%checkpoints.show%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.checkpoints.refresh",
        "title": "%checkpoints.refresh%",
        "category": "Arkestra",
        "icon": "$(refresh)"
      },
      {
        "command": "arkestra.inline.edit",
        "title": "%inline.edit%",
        "category": "Arkestra",
        "icon": "$(sparkle)"
      },
      {
        "command": "arkestra.inline.accept",
        "title": "%inline.accept%",
        "category": "Arkestra",
        "icon": "$(check)"
      },
      {
        "command": "arkestra.inline.reject",
        "title": "%inline.reject%",
        "category": "Arkestra",
        "icon": "$(discard)"
      },
      {
        "command": "arkestra.inline.followUp",
        "title": "%inline.followUp%",
        "category": "Arkestra",
        "icon": "$(comment)"
      },
      {
        "command": "arkestra.inline.diff",
        "title": "%inline.diff%",
        "category": "Arkestra",
        "icon": "$(diff)"
      },
      {
        "command": "arkestra.inline.agent",
        "title": "%inline.agent%",
        "category": "Arkestra",
        "icon": "$(person)"
      },
      {
        "command": "arkestra.permissions.open",
        "title": "%permissions.open%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.shared.openRules",
        "title": "%shared.openRules%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.shared.openMemory",
        "title": "%shared.openMemory%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.shared.remember",
        "title": "%shared.remember%",
        "category": "Arkestra"
      }
    ],
    "chatSessions": [
      {
        "type": "arkestra-room",
        "name": "arkestra",
        "displayName": "%session.displayName%",
        "description": "%session.description%",
        "icon": "$(organization)",
        "welcomeTitle": "%session.welcomeTitle%",
        "welcomeMessage": "%session.welcomeMessage%",
        "inputPlaceholder": "%session.inputPlaceholder%",
        "capabilities": {
          "supportsFileAttachments": true
        },
        "commands": [
          {
            "name": "invite",
            "description": "%command.invite%"
          },
          {
            "name": "agents",
            "description": "%command.agents%"
          },
          {
            "name": "new",
            "description": "%command.new%"
          },
          {
            "name": "template",
            "description": "%command.template%"
          },
          {
            "name": "continue",
            "description": "%command.continue%"
          },
          {
            "name": "approve",
            "description": "%command.approve%"
          },
          {
            "name": "plan",
            "description": "%command.plan%"
          },
          {
            "name": "execute",
            "description": "%command.execute%"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arkestra",
          "title": "%threads.container%",
          "icon": "media/threads.svg"
        }
      ]
    },
    "views": {
      "arkestra": [
        {
          "id": "arkestra.threads",
          "name": "%threads.view%",
          "icon": "media/threads.svg"
        },
        {
          "id": "arkestra.changes",
          "name": "%changes.view%",
          "icon": "media/threads.svg"
        },
        {
          "id": "arkestra.checkpoints",
          "name": "%checkpoints.view%",
          "icon": "media/threads.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arkestra.threads",
        "contents": "%threads.empty%"
      },
      {
        "view": "arkestra.changes",
        "contents": "%changes.empty%"
      },
      {
        "view": "arkestra.checkpoints",
        "contents": "%checkpoints.empty%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arkestra.rooms.newThread",
          "when": "view == arkestra.threads",
          "group": "navigation"
        },
        {
          "command": "arkestra.rooms.newTemplateRoom",
          "when": "view == arkestra.threads",
          "group": "navigation@2"
        },
        {
          "command": "arkestra.changes.keepAll",
          "when": "view == arkestra.changes",
          "group": "navigation@1"
        },
        {
          "command": "arkestra.changes.discardAll",
          "when": "view == arkestra.changes",
          "group": "navigation@2"
        },
        {
          "command": "arkestra.checkpoints.refresh",
          "when": "view == arkestra.checkpoints",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "arkestra.rooms.pin",
          "when": "view == arkestra.threads && viewItem == thread",
          "group": "inline"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "view == arkestra.threads && viewItem == thread.pinned",
          "group": "inline"
        },
        {
          "command": "arkestra.rooms.openThread",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "1_open"
        },
        {
          "command": "arkestra.rooms.setCategory",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "2_edit@1"
        },
        {
          "command": "arkestra.rooms.rename",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "2_edit@2"
        },
        {
          "command": "arkestra.rooms.pin",
          "when": "view == arkestra.threads && viewItem == thread",
          "group": "2_edit@3"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "view == arkestra.threads && viewItem == thread.pinned",
          "group": "2_edit@3"
        },
        {
          "command": "arkestra.changes.keep",
          "when": "view == arkestra.changes && viewItem == change",
          "group": "inline@1"
        },
        {
          "command": "arkestra.changes.discard",
          "when": "view == arkestra.changes && viewItem == change",
          "group": "inline@2"
        },
        {
          "command": "arkestra.checkpoints.restore",
          "when": "view == arkestra.checkpoints && viewItem == checkpoint",
          "group": "inline"
        },
        {
          "command": "arkestra.checkpoints.show",
          "when": "view == arkestra.checkpoints && viewItem == checkpoint",
          "group": "1_show"
        }
      ],
      "commandPalette": [
        {
          "command": "arkestra.rooms.openThread",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.pin",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.setCategory",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.rename",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.showLane",
          "when": "false"
        },
        {
          "command": "arkestra.changes.keep",
          "when": "false"
        },
        {
          "command": "arkestra.changes.discard",
          "when": "false"
        },
        {
          "command": "arkestra.changes.open",
          "when": "false"
        },
        {
          "command": "arkestra.checkpoints.restore",
          "when": "false"
        },
        {
          "command": "arkestra.checkpoints.show",
          "when": "false"
        },
        {
          "command": "arkestra.inline.accept",
          "when": "arkestra.inlineEditPending"
        },
        {
          "command": "arkestra.inline.reject",
          "when": "arkestra.inlineEditPending"
        },
        {
          "command": "arkestra.inline.followUp",
          "when": "arkestra.inlineEditPending"
        },
        {
          "command": "arkestra.inline.diff",
          "when": "arkestra.inlineEditPending"
        },
        {
          "command": "arkestra.inline.edit",
          "when": "editorIsOpen && !editorReadonly"
        }
      ],
      "editor/context": [
        {
          "command": "arkestra.inline.edit",
          "when": "!editorReadonly",
          "group": "1_arkestra@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arkestra.inline.edit",
        "key": "ctrl+k ctrl+k",
        "mac": "cmd+k cmd+k",
        "when": "editorTextFocus && !editorReadonly && !selectionAnchorSet"
      },
      {
        "command": "arkestra.inline.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && arkestra.inlineEditPending"
      },
      {
        "command": "arkestra.inline.reject",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "editorTextFocus && arkestra.inlineEditPending"
      }
    ],
    "configuration": {
      "title": "Arkestra",
      "properties": {
        "arkestra.permissions.machines": {
          "type": "object",
          "scope": "application",
          "default": {},
          "markdownDescription": "%permissions.machines%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "arkestra.permissions.project": {
          "type": "object",
          "scope": "resource",
          "default": {
            "allow": [],
            "deny": []
          },
          "markdownDescription": "%permissions.project%",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:arkestra-rooms",
    "watch": "gulp watch-extension:arkestra-rooms"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions"
  ]
}
