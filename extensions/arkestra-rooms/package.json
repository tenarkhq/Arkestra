{
  "name": "arkestra-rooms",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onChatParticipant:arkestra.room",
    "onChatSession:arkestra-room",
    "onView:arkestra.threads",
    "onWebviewPanel:arkestra.agents",
    "onWebviewPanel:arkestra.lane"
  ],
  "main": "./out/extension",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "arkestra.room",
        "name": "room",
        "fullName": "%room.fullName%",
        "description": "%room.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "invite",
            "description": "%command.invite%"
          },
          {
            "name": "agents",
            "description": "%command.agents%"
          },
          {
            "name": "new",
            "description": "%command.new%"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "arkestra.rooms.new",
        "title": "%command.new%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.invite",
        "title": "%command.invite%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.open",
        "title": "%command.open%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.showAgents",
        "title": "%showAgents%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.newThread",
        "title": "%command.newThread%",
        "category": "Arkestra",
        "icon": "$(add)"
      },
      {
        "command": "arkestra.rooms.openThread",
        "title": "%command.openThread%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.pin",
        "title": "%command.pin%",
        "category": "Arkestra",
        "icon": "$(pin)"
      },
      {
        "command": "arkestra.rooms.unpin",
        "title": "%command.unpin%",
        "category": "Arkestra",
        "icon": "$(pinned)"
      },
      {
        "command": "arkestra.rooms.setCategory",
        "title": "%command.setCategory%",
        "category": "Arkestra",
        "icon": "$(tag)"
      },
      {
        "command": "arkestra.rooms.rename",
        "title": "%command.rename%",
        "category": "Arkestra"
      },
      {
        "command": "arkestra.rooms.showLane",
        "title": "%showLane%",
        "category": "Arkestra"
      }
    ],
    "chatSessions": [
      {
        "type": "arkestra-room",
        "name": "arkestra",
        "displayName": "%session.displayName%",
        "description": "%session.description%",
        "icon": "$(organization)",
        "welcomeTitle": "%session.welcomeTitle%",
        "welcomeMessage": "%session.welcomeMessage%",
        "inputPlaceholder": "%session.inputPlaceholder%",
        "capabilities": {
          "supportsFileAttachments": true
        },
        "commands": [
          {
            "name": "invite",
            "description": "%command.invite%"
          },
          {
            "name": "agents",
            "description": "%command.agents%"
          },
          {
            "name": "new",
            "description": "%command.new%"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arkestra",
          "title": "%threads.container%",
          "icon": "media/threads.svg"
        }
      ]
    },
    "views": {
      "arkestra": [
        {
          "id": "arkestra.threads",
          "name": "%threads.view%",
          "icon": "media/threads.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arkestra.threads",
        "contents": "%threads.empty%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arkestra.rooms.newThread",
          "when": "view == arkestra.threads",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "arkestra.rooms.pin",
          "when": "view == arkestra.threads && viewItem == thread",
          "group": "inline"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "view == arkestra.threads && viewItem == thread.pinned",
          "group": "inline"
        },
        {
          "command": "arkestra.rooms.openThread",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "1_open"
        },
        {
          "command": "arkestra.rooms.setCategory",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "2_edit@1"
        },
        {
          "command": "arkestra.rooms.rename",
          "when": "view == arkestra.threads && viewItem =~ /^thread/",
          "group": "2_edit@2"
        },
        {
          "command": "arkestra.rooms.pin",
          "when": "view == arkestra.threads && viewItem == thread",
          "group": "2_edit@3"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "view == arkestra.threads && viewItem == thread.pinned",
          "group": "2_edit@3"
        }
      ],
      "commandPalette": [
        {
          "command": "arkestra.rooms.openThread",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.pin",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.unpin",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.setCategory",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.rename",
          "when": "false"
        },
        {
          "command": "arkestra.rooms.showLane",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:arkestra-rooms",
    "watch": "gulp watch-extension:arkestra-rooms"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate"
  ]
}
